{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack prepare pnpm@10.34.0 --activate && corepack pnpm --version && corepack pnpm install --no-frozen-lockfile --reporter=append-only",
  "buildCommand": "corepack pnpm run build",
  "redirects": [
    {
      "source": "/nhan-tool/:slug",
      "destination": "/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{0,79})",
      "destination": "/nhan-tool.html?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/admin-settings.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/admin-intake-panel.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/nhan-tool.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/admin-account-panel.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/admin-settings-panel.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/admin-keepalive-panel.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin-trending-cron",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/supabase-keepalive",
      "schedule": "0 1 * * *"
    }
  ]
}
