# Firebase web config dùng cho Google Login.
# Không dán Gemini API key hoặc YouTube Data API key vào file này.
# Gemini/YouTube key: người dùng nhập trong giao diện app, app tự lưu localStorage trên trình duyệt của họ.

# Firebase Auth hiện giữ cấu hình cũ trong firebase-applet-config.json để đăng nhập Google không bị lỗi.
# Chỉ cần đặt các biến VITE_FIREBASE_* nếu muốn đổi hẳn sang Firebase Auth project mới.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""

# Server secrets đặt trên Vercel, không commit giá trị thật lên GitHub:
ADMIN_SECRET=""
ADMIN_SETTINGS_PASSWORD=""
ADMIN_CRON_SECRET=""
FIREBASE_SERVICE_ACCOUNT=""
# Có thể dùng dạng base64 nếu Vercel khó dán JSON nhiều dòng:
FIREBASE_SERVICE_ACCOUNT_BASE64=""
FIRESTORE_DATABASE_ID="(default)"
APP_URL="https://www.tubekey.vn"

# Chỉ dùng khi migrate dữ liệu Firebase cũ sang Firebase mới trên máy local hoặc CI bảo mật.
SOURCE_FIREBASE_SERVICE_ACCOUNT_FILE="./old-service-account.json"
TARGET_FIREBASE_SERVICE_ACCOUNT_FILE="./new-service-account.json"
SOURCE_FIRESTORE_DATABASE_ID="ai-studio-6470d40d-327e-432b-83ff-33781fc60fb8"
TARGET_FIRESTORE_DATABASE_ID="(default)"
MIGRATE_AUTH="1"
MIGRATE_FIRESTORE="1"
MIGRATE_DRY_RUN="1"

# Supabase Postgres (v19, giữ Firebase Auth nhưng chuyển dữ liệu app sang Supabase nếu có đủ ENV)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
